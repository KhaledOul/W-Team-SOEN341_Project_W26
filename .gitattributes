# ─── Default: normalize all text files to LF on commit ───────────────────────
* text=auto eol=lf

# ─── Explicitly mark source and config files as text ─────────────────────────
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.sh        text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# ─── Binary files: Git must never modify these ───────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.pdf       binary
*.zip       binary
*.tar.gz    binary
*.mp4       binary
*.mp3       binary
*.webp      binary
